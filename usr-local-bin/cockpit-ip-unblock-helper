#!/usr/bin/python3
"""
Cockpit IP Unblock Helper — backend script for the ip-unblock Cockpit plugin.

Usage:
    cockpit-ip-unblock-helper --user <name> list
    cockpit-ip-unblock-helper --user <name> unblock <ip> [--force]
    cockpit-ip-unblock-helper --user <name> status
    cockpit-ip-unblock-helper --user <name> recent

Rate limiting: per-user daily cap (default 5). Sudo group members unlimited.
State lives in STATE_FILE. Audit log via syslog + FILE_LOG.
"""

import grp
import json
import os
import re
import shlex
import subprocess
import sys
import syslog
from dataclasses import dataclass
from datetime import date, datetime
from ipaddress import ip_address, ip_network

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
MAX_UNBLOCKS_PER_DAY = 5
STATE_FILE = "/var/lib/cockpit/ip-unblock-state.json"
FILE_LOG = "/var/log/cockpit-ip-unblock.log"
SUDO_GROUP = "sudo"

ALLOWED_TARGETS = {"DROP", "REJECT"}

IPV4_RE = re.compile(
    r"^(?:(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.){3}"
    r"(?:25[0-5]|2[0-4]\d|[01]?\d\d?)$"
)
IPV6_RE = re.compile(
    r"^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|"
    r"([0-9a-fA-F]{1,4}:){1,7}:|"
    r"([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|"
    r"([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|"
    r"([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|"
    r"([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|"
    r"([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|"
    r"[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|"
    r":((:[0-9a-fA-F]{1,4}){1,7}|:)|"
    r"fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|"
    r"::(ffff(:0{1,4}){0,1}:){0,1}"
    r"((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}"
    r"(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|"
    r"([0-9a-fA-F]{1,4}:){1,4}:"
    r"((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}"
    r"(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))$"
)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_CLI_USER = None


@dataclass
class CommandResult:
    ok: bool
    stdout: str
    stderr: str
    unavailable: bool = False


def run_command(argv):
    """Run *argv* without a shell and return its captured result."""
    try:
        completed = subprocess.run(
            argv, capture_output=True, text=True, timeout=10, check=False
        )
    except FileNotFoundError:
        return CommandResult(False, "", f"command unavailable: {argv[0]}", True)
    except subprocess.TimeoutExpired as exc:
        return CommandResult(False, exc.stdout or "", exc.stderr or "")
    return CommandResult(
        completed.returncode == 0, completed.stdout, completed.stderr
    )


class IptablesAdapter:
    """Runtime INPUT-chain block rules provided by the iptables command."""

    def is_available(self):
        return run_command(["iptables", "--version"]).ok

    @staticmethod
    def _parse_rule(line):
        try:
            argv = shlex.split(line)
        except ValueError:
            return None
        if len(argv) >= 2 and argv[:2] == ["-A", "INPUT"]:
            try:
                source_index = argv.index("-s")
            except ValueError:
                try:
                    source_index = argv.index("--source")
                except ValueError:
                    return None
            try:
                target_index = argv.index("-j")
            except ValueError:
                try:
                    target_index = argv.index("--jump")
                except ValueError:
                    return None
            if source_index + 1 >= len(argv) or target_index + 1 >= len(argv):
                return None
            source = argv[source_index + 1]
            target = argv[target_index + 1]
        elif len(argv) >= 5 and argv[0].isdigit():
            # Compatibility for callers/tests that provide iptables -L output.
            source = argv[4]
            target = argv[1]
            argv = ["-A", "INPUT", "-s", source, "-j", target]
        else:
            return None
        try:
            address = ip_address(source.split("/", 1)[0])
            network = ip_network(source, strict=False)
        except ValueError:
            return None
        if network.prefixlen != network.max_prefixlen:
            return None
        if target not in ALLOWED_TARGETS:
            return None
        return {
            "ip": str(address),
            "target": target,
            "argv": argv,
        }

    def _rules(self):
        result = run_command(["iptables", "-S", "INPUT"])
        if not result.ok:
            return []
        return [rule for line in result.stdout.splitlines()
                if (rule := self._parse_rule(line))]

    def list_blocks(self):
        return [
            {
                "source": "iptables",
                "ip": rule["ip"],
                "rule": f"INPUT: {rule['target']}",
                "target": rule["target"],
                "scope": "runtime",
            }
            for rule in self._rules()
        ]

    def unblock(self, ip):
        removed = 0
        for rule in self._rules():
            if rule["ip"] != ip:
                continue
            delete_argv = ["iptables", "-D"] + rule["argv"][1:]
            if run_command(delete_argv).ok:
                removed += 1
        return removed


class Fail2banAdapter:
    """Bans maintained by fail2ban jails."""

    name = "fail2ban"

    @staticmethod
    def _jails():
        result = run_command(["fail2ban-client", "status"])
        if not result.ok:
            return None, result
        for line in result.stdout.splitlines():
            if "Jail list:" not in line:
                continue
            return [jail.strip() for jail in line.split("Jail list:", 1)[1].split(",")
                    if jail.strip()], result
        return [], result

    @staticmethod
    def _banned_ips(jail):
        result = run_command(["fail2ban-client", "status", jail])
        if not result.ok:
            return None, result
        for line in result.stdout.splitlines():
            if "Banned IP list:" in line:
                return line.split("Banned IP list:", 1)[1].split(), result
        return [], result

    def is_available(self):
        jails, result = self._jails()
        return jails is not None and result.ok

    def list_blocks(self):
        jails, _ = self._jails()
        if jails is None:
            return []
        blocks = []
        for jail in jails:
            ips, _ = self._banned_ips(jail)
            if ips is None:
                continue
            blocks.extend({"source": self.name, "ip": ip, "rule": jail, "scope": "runtime"}
                          for ip in ips if is_valid_ip(ip))
        return blocks

    def unblock(self, ip):
        jails, status = self._jails()
        if jails is None:
            return {"source": self.name, "status": "unavailable" if status.unavailable else "failed",
                    "removed": 0, "detail": status.stderr}
        matching = 0
        failures = 0
        removed = 0
        for jail in jails:
            ips, result = self._banned_ips(jail)
            if ips is None:
                failures += 1
            elif ip in ips:
                matching += 1
                if run_command(["fail2ban-client", "set", jail, "unbanip", ip]).ok:
                    removed += 1
                else:
                    failures += 1
        if not matching:
            return {"source": self.name, "status": "not_found", "removed": 0, "detail": ""}
        if failures:
            return {"source": self.name, "status": "failed", "removed": removed,
                    "detail": f"{matching - removed} of {matching} jail unbans failed"}
        return {"source": self.name, "status": "success", "removed": removed, "detail": ""}


class FirewalldAdapter:
    """Runtime and permanent firewalld rich rules for exact host sources."""

    name = "firewalld"
    _SOURCE_RE = re.compile(r'\bsource\s+address="([^"]+)"')

    def is_available(self):
        return run_command(["firewall-cmd", "--state"]).ok

    @classmethod
    def _parse_rule(cls, text):
        source = cls._SOURCE_RE.search(text)
        try:
            fields = shlex.split(text)
        except ValueError:
            return None
        # Rich-rule actions are standalone terminal grammar tokens. Looking in
        # raw text would mistake values such as log prefix="drop" for an
        # action; accepting tokens after an action could also accept malformed
        # rules such as "drop accept".
        if not source or not cls._has_terminal_block_action(fields):
            return None
        try:
            ip = ip_address(source.group(1))
        except ValueError:
            return None
        return str(ip)

    @staticmethod
    def _has_terminal_block_action(fields):
        if fields[-1] in {"drop", "reject"}:
            return True
        return len(fields) >= 2 and fields[-2] == "reject" and fields[-1].startswith("type=")

    def _rules(self):
        rules = []
        for scope, argv in (("runtime", ["firewall-cmd", "--list-rich-rules"]),
                            ("permanent", ["firewall-cmd", "--permanent", "--list-rich-rules"])):
            result = run_command(argv)
            if not result.ok:
                continue
            for text in result.stdout.splitlines():
                ip = self._parse_rule(text)
                if ip:
                    rules.append({"ip": ip, "rule": text, "scope": scope})
        return rules

    def list_blocks(self):
        return [{"source": self.name, **rule} for rule in self._rules()]

    def unblock(self, ip):
        matches = [rule for rule in self._rules() if rule["ip"] == ip]
        if not matches:
            return {"source": self.name, "status": "not_found", "removed": 0, "detail": ""}
        removed = 0
        failures = 0
        for rule in matches:
            argv = ["firewall-cmd"]
            if rule["scope"] == "permanent":
                argv.append("--permanent")
            argv += ["--remove-rich-rule", rule["rule"]]
            if run_command(argv).ok:
                removed += 1
            else:
                failures += 1
        if failures:
            return {"source": self.name, "status": "failed", "removed": removed,
                    "detail": f"{failures} of {len(matches)} rich rule removals failed"}
        return {"source": self.name, "status": "success", "removed": removed, "detail": ""}


class UfwAdapter:
    """UFW DENY and REJECT rules with an exact single-host source."""

    name = "ufw"

    def is_available(self):
        result = run_command(["ufw", "status"])
        return result.ok and "Status: active" in result.stdout

    @staticmethod
    def _parse_rule(line):
        fields = line.split()
        if len(fields) < 4 or fields[-3] not in {"DENY", "REJECT"} or fields[-2] != "IN":
            return None
        try:
            return str(ip_address(fields[-1])), fields[-3]
        except ValueError:
            return None

    def _rules(self):
        result = run_command(["ufw", "status"])
        if not result.ok:
            return []
        return [rule for line in result.stdout.splitlines() if (rule := self._parse_rule(line))]

    def list_blocks(self):
        return [{"source": self.name, "ip": ip, "rule": action, "scope": "runtime"}
                for ip, action in self._rules()]

    def unblock(self, ip):
        matches = [(rule_ip, action) for rule_ip, action in self._rules() if rule_ip == ip]
        if not matches:
            return {"source": self.name, "status": "not_found", "removed": 0, "detail": ""}
        removed = 0
        failures = 0
        for _, action in matches:
            if run_command(["ufw", "--force", "delete", action.lower(), "from", ip]).ok:
                removed += 1
            else:
                failures += 1
        if failures:
            return {"source": self.name, "status": "failed", "removed": removed,
                    "detail": f"{failures} of {len(matches)} UFW rule removals failed"}
        return {"source": self.name, "status": "success", "removed": removed, "detail": ""}


def get_user():
    if _CLI_USER:
        return _CLI_USER
    return os.environ.get("COCKPIT_USER", "unknown")


def is_sudoer(user):
    """Check if *user* is in the sudo group → unlimited unblocks."""
    try:
        group = grp.getgrnam(SUDO_GROUP)
        return user in group.gr_mem
    except KeyError:
        return False


def is_valid_ip(ipstr):
    return bool(IPV4_RE.match(ipstr) or IPV6_RE.match(ipstr))


def audit(action, blocked_ip, result, detail=""):
    user = get_user()
    msg = (
        f"user={user} action={action} blocked_ip={blocked_ip} "
        f"result={result}"
    )
    if detail:
        msg += f" detail={detail}"

    syslog.openlog("cockpit-ip-unblock", syslog.LOG_PID, syslog.LOG_AUTH)
    syslog.syslog(syslog.LOG_NOTICE, msg)
    syslog.closelog()

    try:
        os.makedirs(os.path.dirname(FILE_LOG), exist_ok=True)
        with open(FILE_LOG, "a") as fh:
            ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            fh.write(f"[{ts}] {msg}\n")
    except OSError:
        pass


def load_state():
    try:
        with open(STATE_FILE, "r") as fh:
            return json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE + ".tmp", "w") as fh:
        json.dump(state, fh)
    os.replace(STATE_FILE + ".tmp", STATE_FILE)


def get_quota(user):
    """Return (remaining, limit, unlimited) for *user* today."""
    if is_sudoer(user):
        return -1, -1, True  # unlimited

    state = load_state()
    today = date.today().isoformat()
    entry = state.get(user, {})
    if entry.get("date") != today:
        return MAX_UNBLOCKS_PER_DAY, MAX_UNBLOCKS_PER_DAY, False
    used = entry.get("count", 0)
    remaining = max(0, MAX_UNBLOCKS_PER_DAY - used)
    return remaining, MAX_UNBLOCKS_PER_DAY, False


def consume_quota(user):
    """Increment today's usage. Returns (remaining, limit, unlimited)."""
    if is_sudoer(user):
        return -1, -1, True

    state = load_state()
    today = date.today().isoformat()
    entry = state.get(user, {})
    if entry.get("date") != today:
        entry = {"date": today, "count": 0, "history": []}
    if "history" not in entry:
        entry["history"] = []
    if entry.get("count", 0) >= MAX_UNBLOCKS_PER_DAY:
        return -1, MAX_UNBLOCKS_PER_DAY, False
    entry["count"] = entry.get("count", 0) + 1
    state[user] = entry
    save_state(state)
    return max(0, MAX_UNBLOCKS_PER_DAY - entry["count"]), MAX_UNBLOCKS_PER_DAY, False


def record_history(user, ip):
    """Append an unblock record to the user's state."""
    state = load_state()
    today = date.today().isoformat()
    entry = state.get(user, {"date": today, "count": 0, "history": []})
    if entry.get("date") != today:
        entry = {"date": today, "count": entry.get("count", 0), "history": []}
    if "history" not in entry:
        entry["history"] = []
    entry["history"].append({
        "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "ip": ip,
    })
    # Keep only today's records
    state[user] = entry
    save_state(state)


def get_recent(user):
    """Return today's unblock history for *user*."""
    state = load_state()
    entry = state.get(user, {})
    today = date.today().isoformat()
    if entry.get("date") != today:
        return []
    return entry.get("history", [])


def list_blocked():
    records = []
    for adapter_class in (IptablesAdapter, Fail2banAdapter, FirewalldAdapter, UfwAdapter):
        records.extend(adapter_class().list_blocks())
    return records


def _adapter_for_source(source):
    return {
        "iptables": IptablesAdapter,
        "fail2ban": Fail2banAdapter,
        "firewalld": FirewalldAdapter,
        "ufw": UfwAdapter,
    }.get(source)


def _unblock_source(source, ip, matching_count):
    """Normalize legacy iptables counts and adapter result dictionaries."""
    result = _adapter_for_source(source)().unblock(ip)
    if source == "iptables":
        return {
            "source": source,
            "status": "success" if result == matching_count else "failed",
            "removed": result,
            "detail": "" if result == matching_count else "one or more rules could not be removed",
        }
    return result


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_list():
    user = get_user()
    remaining, limit, unlimited = get_quota(user)
    rules = list_blocked()
    result = {
        "user": user,
        "quota_remaining": remaining,
        "quota_limit": limit,
        "unlimited": unlimited,
        "blocked_ips": rules,
    }
    print(json.dumps(result))


def cmd_status():
    user = get_user()
    remaining, limit, unlimited = get_quota(user)
    print(json.dumps({
        "user": user,
        "quota_remaining": remaining,
        "quota_limit": limit,
        "unlimited": unlimited,
    }))


def cmd_recent():
    """Return today's unblock history for the current user."""
    user = get_user()
    history = get_recent(user)
    print(json.dumps({
        "user": user,
        "history": history,
    }))


def cmd_unblock(ip, force=False):
    user = get_user()

    if not is_valid_ip(ip):
        msg = f"Invalid IP address: {ip}"
        print(f"ERROR: {msg}")
        audit("unblock", ip, "failure", msg)
        sys.exit(1)

    # Check quota (skip for sudoers or --force)
    unlimited = is_sudoer(user)
    if not force and not unlimited:
        remaining, _, _ = get_quota(user)
        if remaining <= 0:
            msg = f"Daily unblock limit ({MAX_UNBLOCKS_PER_DAY}) reached"
            print(f"ERROR: {msg}")
            audit("unblock", ip, "blocked", f"quota_exhausted user={user}")
            sys.exit(1)

    # Find matching rules
    rules = list_blocked()
    matching = [r for r in rules if r["ip"] == ip]

    if not matching:
        msg = f"No iptables DROP/REJECT rule found for IP {ip}"
        print(f"ERROR: {msg}")
        audit("unblock", ip, "failure", "no_matching_rule")
        sys.exit(1)

    source_results = []
    for source in ("iptables", "fail2ban", "firewalld", "ufw"):
        source_matches = [rule for rule in matching if rule["source"] == source]
        if source_matches:
            source_results.append(_unblock_source(source, ip, len(source_matches)))
    removed = sum(result["removed"] for result in source_results)
    errors = [result for result in source_results if result["status"] != "success"]

    if errors:
        result = "partial" if removed else "failure"
        msg = "; ".join(
            f"{item['source']}: {item['detail'] or item['status']}" for item in errors
        )
        print(json.dumps({
            "result": result,
            "ip": ip,
            "rules_removed": removed,
            "source_results": source_results,
            "quota_remaining": get_quota(user)[0],
            "quota_limit": get_quota(user)[1],
            "unlimited": unlimited or force,
        }))
        audit("unblock", ip, result, msg)
        if removed > 0 and not force and not unlimited:
            consume_quota(user)
        if removed > 0:
            record_history(user, ip)
        sys.exit(1)

    # Consume quota and record
    if not force and not unlimited:
        remaining, limit, _ = consume_quota(user)
    else:
        remaining, limit, _ = get_quota(user)

    record_history(user, ip)

    print(json.dumps({
        "result": "success",
        "ip": ip,
        "rules_removed": removed,
        "source_results": source_results,
        "quota_remaining": remaining,
        "quota_limit": limit,
        "unlimited": unlimited or force,
    }))
    audit("unblock", ip, "success", f"rules_removed={removed}")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def usage():
    print("Usage: cockpit-ip-unblock-helper [--user <n>] <list|status|unblock <ip> [--force]|recent>")
    sys.exit(1)


if __name__ == "__main__":
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] == "--user":
        _CLI_USER = args[1]
        args = args[2:]
    elif len(args) >= 3 and args[1] == "--user":
        _CLI_USER = args[2]
        args = [args[0]] + args[3:]

    if len(args) < 1:
        usage()

    cmd = args[0]

    if cmd == "list":
        cmd_list()
    elif cmd == "status":
        cmd_status()
    elif cmd == "recent":
        cmd_recent()
    elif cmd == "unblock":
        if len(args) < 2:
            usage()
        ip = args[1]
        force = "--force" in args
        cmd_unblock(ip, force)
    else:
        usage()
