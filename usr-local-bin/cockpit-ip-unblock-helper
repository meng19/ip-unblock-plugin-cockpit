def usage():
    print("Usage: cockpit-ip-unblock-helper <list|status|unblock <ip> [--source all|iptables|fail2ban|firewalld|ufw]|bulk-unblock --source <source> <ip>...|recent|locate-ip <ip> [zh|en]>")
    sys.exit(1)


def parse_cli(args):
    """Parse the small fixed CLI grammar without accepting ambiguous flags."""
    if not args:
        raise ValueError("missing command")
    parsed = {"command": args[0]}
    if args[0] == "locate-ip":
        if len(args) not in (2, 3):
            raise ValueError("invalid locate-ip syntax")
        lang = args[2] if len(args) == 3 else "zh"
        if lang not in ("zh", "en"):
            raise ValueError("invalid locate-ip language")
        return {"command": "locate-ip", "ip": args[1], "lang": lang}
    if args[0] == "bulk-unblock":
        if len(args) < 4 or args[1] != "--source" or args[2] not in VALID_SOURCES:
            raise ValueError("invalid bulk-unblock syntax")
        ips = args[3:]
        if len(ips) > MAX_BULK_UNBLOCKS or any(ip.startswith("-") for ip in ips):
            raise ValueError("invalid bulk-unblock IPs")
        return {"command": "bulk-unblock", "source": args[2], "ips": ips}
    if args[0] != "unblock":
        if len(args) != 1:
            raise ValueError("unexpected arguments")
        return parsed
    if len(args) < 2:
        raise ValueError("missing IP")
    parsed.update({"ip": args[1], "source": "all"})
    index = 2
    seen = set()
    while index < len(args):
        flag = args[index]
        if flag == "--source" and flag not in seen and index + 1 < len(args):
            source = args[index + 1]
            if source not in VALID_SOURCES:
                raise ValueError("invalid source")
            parsed["source"] = source
            seen.add(flag)
            index += 2
        else:
            raise ValueError("invalid or duplicate option")
    return parsed


if __name__ == "__main__":
    args = sys.argv[1:]
    try:
        parsed = parse_cli(args)
    except ValueError:
        usage()

    cmd = parsed["command"]
    if cmd == "list":
        cmd_list()
    elif cmd == "status":
        cmd_status()
    elif cmd == "recent":
        cmd_recent()
    elif cmd == "locate-ip":
        cmd_locate_ip(parsed["ip"], parsed["lang"])
    elif cmd == "unblock":
        cmd_unblock(parsed["ip"], parsed["source"])
    elif cmd == "bulk-unblock":
        cmd_bulk_unblock(parsed["ips"], parsed["source"])
    else:
        usage()
