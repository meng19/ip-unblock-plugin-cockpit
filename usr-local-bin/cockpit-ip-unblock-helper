def cmd_list():
    user = get_user()
    if not is_authorized(user):
        print(json.dumps({"result": "failure", "error": "sudo membership required"}))
        return
    print(json.dumps(build_list_payload(user)))


def cmd_status():
    user = get_user()
    remaining, limit, unlimited = get_quota(user)
    print(json.dumps({
        "user": user,
        "quota_remaining": remaining,
        "quota_limit": limit,
        "unlimited": unlimited,
    }))


def cmd_recent():
    """Return today's unblock history for the current user."""
    user = get_user()
    if not load_policy()["show_recent_history"]:
        print(json.dumps({"user": user, "history": []}))
        return
    history = get_recent(user)
    print(json.dumps({
        "user": user,
        "history": history,
    }))


def cmd_locate_ip(ip, lang):
    """Resolve a public IP location without requiring browser-side external fetches."""
    if not is_valid_ip(ip):
        print(json.dumps({"status": "unknown", "ip": ip}))
        return
    print(json.dumps(locate_ip(ip, lang)))


def cmd_unblock(ip, source="all"):
    user = get_user()

    if not is_valid_ip(ip):
        msg = f"Invalid IP address: {ip}"
        print(f"ERROR: {msg}")
        audit("unblock", ip, "failure", msg)
        sys.exit(1)

    # Check quota (sudo group members are unlimited).
    unlimited = is_sudoer(user)
    if not unlimited:
        remaining, _, _ = get_quota(user)
        if remaining <= 0:
            msg = f"Daily unblock limit ({MAX_UNBLOCKS_PER_DAY}) reached"
            print(f"ERROR: {msg}")
            audit("unblock", ip, "blocked", f"quota_exhausted user={user}")
            sys.exit(1)

    payload = unblock_ip(user, ip, source)
    detail = "; ".join(
        f"{item['source']}: {item['detail'] or item['status']}"
        for item in payload["source_results"] if item["status"] != "success"
    )
    print(json.dumps(payload))
    audit("unblock", ip, payload["result"], detail or f"rules_removed={payload['rules_removed']}")
    if payload["result"] == "failure":
        sys.exit(1)


def cmd_bulk_unblock(ips, source):
    """Validate and execute a bulk request, enforcing policy server-side."""
    user = get_user()
    if not is_authorized(user):
        print(json.dumps({"result": "failure", "error": "sudo membership required"}))
        audit("bulk-unblock", ",".join(ips), "failure", "unauthorized")
        return
    invalid_ips = [ip for ip in ips if not is_valid_ip(ip)]
    if invalid_ips:
        msg = f"Invalid IP address: {invalid_ips[0]}"
        print(json.dumps({"result": "failure", "error": msg}))
        audit("bulk-unblock", invalid_ips[0], "failure", msg)
        return
    payload = bulk_unblock(user, ips, source)
    print(json.dumps(payload))
    audit("bulk-unblock", ",".join(ips), payload["result"],
          f"processed={payload['summary']['processed']} rules_removed={payload['summary']['rules_removed']}")


